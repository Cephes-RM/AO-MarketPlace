{
  "name": "albion-platform",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:seed": "docker exec -i pg-tutorial psql -U postgres -d AO-db < scripts/seed-benchmark.sql",
    "bench:run": "pwsh -File ./scripts/bench.ps1",
    "bench:smoke": "pwsh -File ./scripts/bench.ps1 -Clients 4 -Duration 10 -Warmup 3"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "vitest": "^5.0.1"
  }
}