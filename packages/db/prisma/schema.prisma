generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Alliance {
  external_alliance_id String   @id
  name                 String   @unique
  guilds               Guild[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Guild {
  external_guild_id String   @id
  name              String   @unique
  allianceId        String?
  alliance          Alliance? @relation(fields: [allianceId], references: [external_alliance_id])
  memberships       GuildMembership[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Player {
  external_player_id String   @id
  name               String
  region             String
  fame               BigInt
  killFame           BigInt
  deathFame          BigInt
  rating             Int      @default(0)
  stars              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  kills              KillEvent[] @relation("PlayerKills")
  deaths             KillEvent[] @relation("PlayerDeaths")
  guildMemberships   GuildMembership[]
}

model GuildMembership {
  playerId String
  guildId  String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  player   Player    @relation(fields: [playerId], references: [external_player_id], onDelete: Cascade)
  guild    Guild     @relation(fields: [guildId], references: [external_guild_id])

  @@id([playerId, guildId, joinedAt])
  @@index([playerId, joinedAt])
  @@index([guildId])
}

model KillEvent {
  id        String   @id
  killerId  String
  victimId  String

  killer    Player   @relation("PlayerKills", fields: [killerId], references: [external_player_id])
  victim    Player   @relation("PlayerDeaths", fields: [victimId], references: [external_player_id])

  location  String
  totalFame BigInt
  createdAt DateTime
}
