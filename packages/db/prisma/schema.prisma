generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Alliance {
  id                   String   @id @default(cuid())
  external_alliance_id String   @unique
  name                 String   @unique
  guilds               Guild[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Guild {
  id                 String   @id @default(cuid())
  external_guild_id  String   @unique
  name               String   @unique
  allianceId         String?
  alliance           Alliance? @relation(fields: [allianceId], references: [external_alliance_id])
  players            Player[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Player {
  id                String   @id @default(cuid())
  external_player_id String   @unique
  name              String
  guildId           String?
  guild             Guild?   @relation(fields: [guildId], references: [external_guild_id])
  guildName         String?
  alliance          String?
  region            String
  fame              BigInt
  killFame          BigInt
  deathFame         BigInt
  rating            Int      @default(0)
  stars             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  kills             KillEvent[] @relation("PlayerKills")
  deaths            KillEvent[] @relation("PlayerDeaths")
}

model KillEvent {
  id         String   @id

  killerId   String
  victimId   String

  killer     Player   @relation("PlayerKills", fields: [killerId], references: [id])
  victim     Player   @relation("PlayerDeaths", fields: [victimId], references: [id])

  location   String
  totalFame  BigInt
  createdAt  DateTime

  items      KillEventItem[]
}

/// One equipped item worn during a kill event.
/// role is "KILLER" or "VICTIM"; slot is an Albion equipment slot such as
/// "mainHand" or "cape". A slot the player left empty simply has no row.
model KillEventItem {
  id       String @id @default(cuid())

  eventId  String
  event    KillEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  role     String
  slot     String
  itemType String
  quality  Int?
  count    Int?

  @@unique([eventId, role, slot])
  @@index([itemType])
}
